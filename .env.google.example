# === GOOGLE CALENDAR INTEGRATION ===
# Obtener estas credenciales en: https://console.cloud.google.com/
# 1. Crear proyecto en Google Cloud Console
# 2. Activar Google Calendar API
# 3. Crear credenciales OAuth 2.0
# 4. Configurar URL de redireccionamiento: http://tony.test/agenda/google/callback

GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Ejemplo de configuración:
# GOOGLE_CLIENT_ID=123456789012-abcdefghijklmnopqrstuvwxyz1234567.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-abcdefghijklmnopqrstuvwxyz123456